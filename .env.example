# The settings of one device. Copy this file to a .env file in the tergite-backend folder, or
# to any file BCC_ENV_FILE names (several, one per device, separated as in PATH), and fill in
# the necessary values. It is a simple list of keys and values, also known as an INI file on
# MS Windows.
#
# Every key is BCC_<NAME>, for the setting <NAME>, and the same name sets it in the
# environment; a key without the BCC_ prefix is an error. In the environment, over this file:
# - BCC_<NAME>, e.g. BCC_MAX_IDLE_TIME, sets <NAME> for every device the process serves
# - BCC_<PREFIX>_<NAME>, e.g. BCC_LOKE_MAX_IDLE_TIME, sets it for one device, over BCC_<NAME>;
#   <PREFIX> is the device's DEFAULT_PREFIX in upper case, with "_" for any character but
#   letters and digits, e.g. BCC_QISKIT_PULSE_1Q_ for qiskit_pulse_1q
# DEFAULT_PREFIX itself comes from the environment's BCC_DEFAULT_PREFIX or this file.
#
# One process serves several devices when given one such file for each, e.g.
# `bcc start --env-file loke.env --env-file thor.env`, each device's API then being under
# /<its DEFAULT_PREFIX>/.

# (1) General
# Set the default file prefix and the backend name for the backend application.
# If you are using any of the backends from the mongoDB, please enter this name for DEFAULT_PREFIX
BCC_DEFAULT_PREFIX=default

# (2) Jobs and workers
# This first block can be left as is. Do not change any variable unless you know what you are doing!
# It contains definitions for the temporary directories and file names.
BCC_STORAGE_ROOT=/tmp
BCC_LOGFILE_DOWNLOAD_POOL_DIRNAME=logfile_download_pool
BCC_JOB_UPLOAD_POOL_DIRNAME=job_upload_pool
BCC_JOB_PRE_PROC_POOL_DIRNAME=job_preproc_pool
# Store the temporary data from the backend-specific executor class
BCC_EXECUTOR_DATA_DIRNAME=executor_data
# The folder under STORAGE_ROOT for the job uploads, the log files and the job supervisor log
# default: the DEFAULT_PREFIX
# BCC_STORAGE_PREFIX_DIRNAME=default
# The job supervisor's log file, in that folder
# default: job_supervisor.log
BCC_JOB_SUPERVISOR_LOG=job_supervisor.log

# (3) BCC
# The URL this backend is reached at, from which MSS downloads job log files; for one of
# several devices of a process, it ends with /<the DEFAULT_PREFIX>
# default: http://localhost:8000
BCC_MACHINE_ROOT_URL=http://host:port
# the port the API listens on when `bcc` is given no --port; the first device's, of several
BCC_PORT=8000

# (4) MSS
# This is to configure port and URL for the frontend machine.
# default = http://localhost:8002
BCC_MSS_MACHINE_ROOT_URL=http://host:port
#
# The public RSA key pem file for the MSS server, preferably used internally only for the stack
# this is required if you are to use MSS so uncomment it
# default (in the current folder): public-mss-key.pem
# BCC_MSS_PUBLIC_KEY_PATH=
#
# The maximum time in seconds that a nonce from MSS can be valid when its timestamp is
# compared to current time.
# Note that this may have issues if any of the system clocks of BCC or MSS are not at the correct time
# default: 300
BCC_MSS_NONCE_TTL=300
#
# The endpoint for sending device events to the MSS
# default = ws://<MSS_MACHINE_ROOT_URL's host and port>/devices/ws/<DEFAULT_PREFIX>, or wss:// for https
BCC_MSS_DEVICE_EVENTS_ENDPOINT=ws://host:port/devices/ws/<DEFAULT_PREFIX>
#
# The timeout in seconds for the socket connection to MSS
# default = 5
BCC_MSS_CONNECTION_TIMEOUT=5
#
# The number of times to retry connecting to MSS before giving up
# default = 5
BCC_MSS_CONNECTION_MAX_ATTEMPTS=5
#
# The timeout in seconds for receiving a response from MSS after pushing an event
# default = 120
BCC_MSS_RESPONSE_TIMEOUT=120

#
# The maximum delay we can have between reconnection attempts to MSS
# default = 60
BCC_MSS_MAX_RECONNECTION_DELAY=60

# (5) Instrument interfacing and simulators
# This is to configure the hardware or simulated measurement instruments.
#
# The backend's configuration: its name, qubits, couplers and the like. A [simulator] section
# in it makes the device a simulated one, a chip behind its dummy clusters.
# See backend_config.example.toml, and tests/fixtures/backend_config.simq1.toml for a simulator
# Default: "backend_config.toml"
BCC_BACKEND_SETTINGS="backend_config.toml"
# The executor, the same for real instruments, dummy clusters and simulated devices
#
# Can take only "quantify", the default.
BCC_EXECUTOR_TYPE=quantify
# Sometimes we may need to seed the database with some calibration data.
# It is actually optional for real devices but for simulators, it is a hard requirement
# We use a seed file.
#
# Default: "calibration.seed.toml"
BCC_CALIBRATION_SEED="calibration.seed.toml"
# For real devices running on quantify scheduler, we need a configuration file
# of the exact same format as that expected by quantify-scheduler
#
# Default: "quantify-config.json"
BCC_QUANTIFY_CONFIG_FILE="quantify-config.json"
# For real devices running on quantify scheduler, we need a metadata file
# to specify such things as IP addresses of different clusters etc.
#
# Default: "quantify-metadata.yml"
BCC_QUANTIFY_METADATA_FILE="quantify-metadata.yml"

# The config file with the initial values for the device
# configuration.
#
# Default: "device_config.calib.toml"
BCC_CALIBRATION_DEVICE_CONFIG_FILE="device_config.calib.toml"

# The config file that configures the wiring on the QBlox SPI rack.
#
# Default: "spi_config.calib.toml"
BCC_CALIBRATION_SPI_CONFIG_FILE="spi_config.calib.toml"


# The config file with the runtime values for the calibration nodes.
#
# Default: "node_config.calib.toml"
BCC_CALIBRATION_NODE_CONFIG_FILE="node_config.calib.toml"

# Whether the clusters (especially on quantify executor) can be reset
#
# Default: False
BCC_ARE_CLUSTERS_RESETTABLE=False
# Whether to SPI currents should be restored especially for the quantify executor
#
# Default: False
BCC_SHOULD_RESTORE_CURRENTS=False

# (6) Authentication
# The private key for authenticating this backend to MSS
#
# Default: "private-bcc-key.pem"
BCC_PRIVATE_KEY_FILE="private-bcc-key.pem"
#
# The password for the private key
# BCC_PRIVATE_KEY_PASSWORD=


# (7) Operation mode
# APP_SETTINGS reflect which environment the app is to run in.
# Options:
#  - development
#  - production
#  - staging
#  - test
# Default is production
BCC_APP_SETTINGS=production

# Maximum time in seconds a booking is allowed to have
# Negative values not allowed. Negative values are automatically changed to 0
# default: 21600 i.e 6 hours
BCC_MAX_TIME_SLOT_LENGTH=21600

# Minimum time in seconds a booking is allowed to have
# Negative values not allowed. Negative values are automatically changed to 0
# default: 120 i.e 2 minutes
BCC_MIN_TIME_SLOT_LENGTH=120

# Maximum number of bookings per day that a user can have
# Negative values not allowed. Negative values are automatically changed to 0
# default: 1
BCC_MAX_SLOTS_PER_DAY=1

# (9) Uvicorn and rq logging 

# use this set root logger log level
# CRITICAL|ERROR|WARNING|INFO|DEBUG
# default: ERROR
BCC_LOG_LEVEL=ERROR

# Maximum time in seconds that a booking can lie idle without a running job
# Note that this must be an integer
# Negative values not allowed. Negative values are automatically changed to 0
# default: 900 i.e. 15 minutes
BCC_MAX_IDLE_TIME=900

# Maximum time in seconds jobs on the execution queue should take
#
# default: 10 minutes
BCC_MAX_EXECUTION_TIME=600

# Maximum time in seconds jobs on the preprocessing queue should take
#
# default: 5 minutes
BCC_MAX_PREPROCESSING_TIME=300

# Maximum time in seconds jobs on the postprocessing queue should take
#
# default: 3 minutes
BCC_MAX_POSTPROCESSING_TIME=180

# Maximum time in seconds that jobs on the recalibration queue should take
#
# default: 5400 i.e. 1.5 hours
BCC_MAX_RECALIBRATION_QUEUE_TIME=5400

# Maximum time in seconds a preprocessed job waits to execute, e.g. for room between
# bookings, before it is failed and its user told; 0 is no limit
#
# default: 86400 i.e. 1 day
BCC_MAX_EXECUTION_QUEUE_TIME=86400

# Maximum time in seconds a worker that bcc start runs may take to start, connecting to
# the clusters and loading the executor, before it is taken to be stuck and killed; 0 is
# no limit
#
# default: 600 i.e. 10 minutes
BCC_MAX_WORKER_START_TIME=600

# Maximum time in seconds a worker with nothing to do waits before it looks again: how late
# a lost wake-up, a due recalibration or a dead worker's job is noticed; above 0
#
# default: 5
BCC_MAX_WORKER_WAIT_TIME=5

# The default time in seconds between consecutive recalibration runs
#
# default: 1 day
BCC_DEFAULT_RECALIBRATION_INTERVAL=86400

# The SQL database URL of format `dialect+driver://username:password@host:port/database`
# See: https://docs.sqlalchemy.org/en/20/core/engines.html
# default: sqlite:///booking_db.db
BCC_BOOKING_DB_URL="sqlite:///booking_db.db"

# The secret key for use when signing the JWT
BCC_JWT_SECRET="some-JWT-secret-probably-generated-with-openssl"

# The time to live for the JWT token
# Negative values not allowed. Negative values are automatically changed to 0
# default: 900
BCC_JWT_TTL=900

# the comma separated list of URLs where
# Javascript can access this API without raising CORS errors
# See https://fastapi.tiangolo.com/tutorial/cors/?h=cors#use-corsmiddleware
# default: ""
BCC_CORS_ORIGINS=""

# a mock current date to make bookings act as if the date now is a given static value
# if empty, the right current date is used
# default: ""
BCC_CURRENT_DATE=""

# How long, in seconds, a job is kept after it last changed.
# default: 1209600 (two weeks)
BCC_JOBS_STORE_TTL=1209600